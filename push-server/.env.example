# Copy to .env on the push SERVER only. Never commit real values.
# Never put these in GitHub Pages, the public repo, the phone app, or logs.

# From: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-me@example.com

# openssl rand -hex 32
# The score/analysis routine reads this from its own secret store.
DISPATCH_TOKEN=

# Browser origin of the Pages app. Scheme + host only, no path, no star.
ALLOWED_ORIGINS=https://iqbalsidek1101-hub.github.io

# Set to 1 only for a local preview on localhost. Leave unset on the server.
# ALLOW_LOCAL_ORIGINS=1

DATA_DIR=./data
HOST=127.0.0.1
PORT=8787

# Set to 1 only when a reverse proxy overwrites the client IP.
# TRUST_PROXY=1

# Optional exact calls.json URLs the server may fetch if the body asks.
# Prefer posting the file body from the routine instead.
# CALLS_URLS=https://iqbalsidek1101-hub.github.io/gold-calls/calls.json
